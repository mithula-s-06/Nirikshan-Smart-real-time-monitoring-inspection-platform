# ==============================================================================
# NIRIKSHAN Platform Environment Configuration
# Department of Social Justice & Empowerment, Government of India
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
SERVE_FRONTEND=true
LOG_LEVEL=info

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5000,http://localhost:5173

# Database Connections
MONGODB_URI=mongodb://127.0.0.1:27017/nirikshan_db
USE_MEMORY_DB=false
REDIS_URL=redis://127.0.0.1:6379

# Cryptographic Token Secrets
JWT_ACCESS_SECRET=nirikshan_prod_access_secret_super_secure_key_2026_xyz!
JWT_REFRESH_SECRET=nirikshan_prod_refresh_secret_super_secure_key_2026_abc@
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# File Storage Provider (local | s3 | r2 | minio | azure)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# AI Edge Service Integration
AI_SERVICE_URL=http://127.0.0.1:8000
