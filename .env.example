# ==========================================
# NIRIKSHAN PLATFORM - ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:19006

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/nirikshan_db
# Set to 'true' to use in-memory mongo server if local MongoDB is not running
USE_MEMORY_DB=true

# Authentication Secrets (Generate secure 256-bit strings in production)
JWT_ACCESS_SECRET=nirikshan_dev_access_secret_super_secure_key_2026_xyz!
JWT_REFRESH_SECRET=nirikshan_dev_refresh_secret_super_secure_key_2026_abc@
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Cache & Message Broker (Optional / Future)
REDIS_URL=redis://127.0.0.1:6379

# Storage Provider: 'local' | 's3' | 'r2' | 'minio' | 'azure'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=nirikshan-evidence
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# AI Service Configuration
AI_SERVICE_URL=http://127.0.0.1:8000

# Firebase Cloud Messaging (Optional for MVP Notifications)
FIREBASE_PROJECT_ID=nirikshan-sih-2026
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@nirikshan-sih-2026.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Logging Configuration
LOG_LEVEL=debug
